{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean",
      "description": "Enable this pilot on this instance.",
      "default": false
    },
    "editableOnPortal": {
      "type": "boolean",
      "description": "Allow moderators to manage portal tags.",
      "default": false
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Declared channel key",
        "x-cicord-ref": "channel"
      },
      "maxItems": 32,
      "default": []
    },
    "debounceSeconds": {
      "type": "integer",
      "description": "Minimum time between automatic answers in one channel",
      "minimum": 5,
      "maximum": 3600,
      "default": 60
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
