{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Moderation plugin config",
  "type": "object",
  "required": [
    "logChannel"
  ],
  "properties": {
    "logChannel": {
      "description": "Staff channel of the audit log (every action, joins and leaves).",
      "type": "string",
      "x-cicord-ref": "channel"
    },
    "warningDays": {
      "description": "Warnings expire after this many days.",
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 3650,
      "default": 30,
      "x-cicord-access": "moderator"
    },
    "purge": {
      "description": "Limits for a staff-confirmed message purge.",
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "maxCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 500
        }
      }
    },
    "escalation": {
      "description": "Automatic action when a member reaches a number of active warnings.",
      "type": "array",
      "maxItems": 10,
      "default": [
        {
          "warnings": 3,
          "action": "timeout"
        }
      ],
      "x-cicord-access": "moderator",
      "items": {
        "type": "object",
        "required": [
          "warnings",
          "action"
        ],
        "properties": {
          "warnings": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "action": {
            "enum": [
              "timeout",
              "kick",
              "ban",
              "tempban"
            ]
          },
          "durationMinutes": {
            "description": "Duration of a timeout or temporary ban, in minutes.",
            "type": "integer",
            "minimum": 1,
            "maximum": 40320,
            "default": 60
          }
        },
        "additionalProperties": false
      }
    },
    "dmMembers": {
      "description": "Tell members by DM why they were warned, timed out, kicked or banned.",
      "type": "boolean",
      "default": true
    },
    "flood": {
      "description": "Times out members who post too many messages too fast.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "messages": {
          "type": "integer",
          "minimum": 2,
          "maximum": 50,
          "default": 6
        },
        "seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120,
          "default": 5
        },
        "timeoutMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440,
          "default": 5
        },
        "exemptRoles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": [],
          "x-cicord-ref": "role"
        }
      },
      "additionalProperties": false
    },
    "log": {
      "description": "Member events written to the audit log.",
      "type": "object",
      "properties": {
        "joins": {
          "type": "boolean",
          "default": true
        },
        "leaves": {
          "type": "boolean",
          "default": true
        },
        "updates": {
          "description": "Nickname and role changes.",
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "webhook": {
      "description": "Also send every action to a Slack or Discord webhook.",
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://(hooks\\.slack\\.com|discord\\.com)/"
        },
        "format": {
          "enum": [
            "slack",
            "discord"
          ],
          "default": "slack"
        }
      },
      "additionalProperties": false
    },
    "quarantineRole": {
      "type": "string",
      "x-cicord-ref": "role",
      "description": "Assignable quarantine role without declared holders."
    },
    "sanction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowStaffTargets": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "bot",
              "instance"
            ],
            "properties": {
              "bot": {
                "type": "string"
              },
              "instance": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "appeals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "via": {
          "enum": [
            "portal",
            "ticket"
          ],
          "default": "portal"
        },
        "cooldownDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "default": 7
        },
        "channel": {
          "type": "string",
          "x-cicord-ref": "channel"
        }
      }
    }
  },
  "additionalProperties": false
}
