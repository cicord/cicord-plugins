{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tickets plugin config",
  "type": "object",
  "required": ["panelChannel"],
  "properties": {
    "types": {
      "description": "Ticket types with independent forms and staff roles. Without types the original general queue is used.",
      "type": "array",
      "maxItems": 5,
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "name", "staffRoles"],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,23}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 45
          },
          "staffRoles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "maxItems": 10,
            "x-cicord-ref": "role"
          },
          "category": {
            "type": "string",
            "x-cicord-ref": "category"
          },
          "logChannel": {
            "type": "string",
            "x-cicord-ref": "channel"
          },
          "defaultLabels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "maxItems": 10
          },
          "fields": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label"],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 45
                },
                "required": {
                  "type": "boolean",
                  "default": false
                }
              }
            }
          }
        }
      }
    },
    "transcriptRetentionDays": {
      "type": "integer",
      "default": 30,
      "minimum": 1,
      "maximum": 365
    },
    "firstResponseMinutes": {
      "type": "integer",
      "default": 0,
      "minimum": 0,
      "maximum": 10080
    },
    "inactivityHours": {
      "type": "integer",
      "default": 0,
      "minimum": 0,
      "maximum": 8760
    },
    "modmailType": {
      "type": "string",
      "description": "Ticket type for incoming DMs. Defaults to the first type."
    },
    "panelChannel": {
      "description": "Default channel of the ticket panel (/ticket-panel can post it elsewhere).",
      "type": "string",
      "x-cicord-ref": "channel"
    },
    "category": {
      "description": "Category ticket channels are created in. Without it, at the top of the channel list.",
      "type": "string",
      "x-cicord-ref": "category"
    },
    "staffRoles": {
      "description": "Staff roles for the legacy general queue when no types are configured.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "maxItems": 10,
      "default": [],
      "x-cicord-ref": "role"
    },
    "logChannel": {
      "description": "Staff channel that receives a summary of each closed ticket. No summary without it.",
      "type": "string",
      "x-cicord-ref": "channel"
    },
    "panel": {
      "description": "The message with the \"open a ticket\" button.",
      "type": "object",
      "x-cicord-access": "moderator",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "x-cicord-widget": "markdown"
        },
        "buttonLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "default": "#5865f2",
          "x-cicord-widget": "color"
        }
      },
      "additionalProperties": false
    },
    "welcomeMessage": {
      "description": "First message of a ticket. Placeholders: {member}, {staff}, {subject}, {number}.",
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "x-cicord-widget": "markdown",
      "x-cicord-access": "moderator"
    },
    "channelName": {
      "description": "Name of ticket channels. Placeholders: {number}, {member}.",
      "type": "string",
      "minLength": 1,
      "maxLength": 90,
      "default": "ticket-{number}"
    },
    "maxOpenPerMember": {
      "description": "Open tickets a member may have at the same time.",
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "default": 1,
      "x-cicord-access": "moderator"
    },
    "labels": {
      "description": "Labels members pick when they open a ticket from the portal, and staff set on tickets. Tickets store the key: renaming a label keeps them, changing its key does not.",
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "required": ["key"],
        "properties": {
          "key": {
            "description": "Stable identifier: lowercase letters, digits and dashes.",
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
          },
          "name": {
            "description": "Shown to members and staff.",
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "emoji": {
            "description": "Optional emoji shown before the name.",
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        },
        "additionalProperties": false
      },
      "default": [
        {
          "key": "question",
          "emoji": "❓"
        },
        {
          "key": "bug",
          "emoji": "🐛"
        },
        {
          "key": "self-hosting",
          "emoji": "🖥️"
        },
        {
          "key": "plugin",
          "emoji": "🧩"
        },
        {
          "key": "other"
        }
      ],
      "x-cicord-access": "moderator"
    },
    "recordRetentionDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 730,
      "default": 365,
      "description": "Days to keep closed tickets, notes and indexes. The longer of this and transcript retention applies."
    },
    "appealType": {
      "type": "string",
      "description": "Ticket type for moderation appeals. Required for appeals when multiple types are configured and the caller omits a type."
    },
    "locale": {
      "type": "string",
      "enum": ["en", "fr"],
      "description": "Override the interaction and server language."
    }
  },
  "additionalProperties": false
}
