{
  "type": "object",
  "properties": {
    "actorId": {
      "type": "string"
    },
    "actorType": {
      "type": "string",
      "enum": [
        "human",
        "bot",
        "unknown",
        "cicord"
      ]
    },
    "trigger": {
      "type": "string"
    },
    "count": {
      "type": "integer"
    },
    "responses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Responses applied. Always empty in monitor mode."
    },
    "wouldRespond": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "removeRoles",
          "kick",
          "finalSanction",
          "requestSync"
        ]
      },
      "description": "Responses enforce mode would apply, in order. Monitor mode applies none (responses is empty)."
    },
    "certainty": {
      "type": "string",
      "enum": [
        "confirmed",
        "unknown",
        "probable"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "actorType",
    "trigger",
    "count",
    "responses",
    "certainty"
  ]
}
