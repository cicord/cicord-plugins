{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Staff shifts configuration",
  "type": "object",
  "properties": {
    "staffRole": {
      "type": "string",
      "description": "Role permitted to manage personal shifts and go on duty.",
      "x-cicord-ref": "role",
      "minLength": 1
    },
    "dutyRole": {
      "type": "string",
      "description": "Duty role without declarative member assignments.",
      "x-cicord-ref": "role",
      "minLength": 1
    },
    "maxHours": {
      "type": "integer",
      "description": "Hours before an active shift ends automatically.",
      "minimum": 1,
      "maximum": 48,
      "default": 8
    },
    "reminderMinutes": {
      "type": "integer",
      "description": "Minutes before a scheduled shift to send a DM.",
      "minimum": 0,
      "maximum": 1440,
      "default": 15
    },
    "enabled": {
      "type": "boolean",
      "description": "Enable this plugin instance.",
      "default": true
    },
    "locale": {
      "type": "string",
      "description": "Override the language of this instance.",
      "enum": [
        "en",
        "fr"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "enabled": {
            "const": false
          }
        },
        "required": [
          "enabled"
        ]
      },
      "else": {
        "required": [
          "staffRole",
          "dutyRole"
        ]
      }
    }
  ]
}
