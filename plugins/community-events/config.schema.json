{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,50}$"
          },
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 800
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "description": "First occurrence as an ISO 8601 timestamp. The series repeats weekly on the same local weekday and time in timeZone."
          },
          "timeZone": {
            "type": "string",
            "description": "IANA time zone that keeps the weekly local time across daylight-saving changes. UTC keeps the UTC time fixed.",
            "enum": [
              "UTC",
              "Europe/London",
              "Europe/Dublin",
              "Europe/Lisbon",
              "Europe/Paris",
              "Europe/Brussels",
              "Europe/Amsterdam",
              "Europe/Luxembourg",
              "Europe/Berlin",
              "Europe/Zurich",
              "Europe/Vienna",
              "Europe/Madrid",
              "Europe/Rome",
              "Europe/Stockholm",
              "Europe/Oslo",
              "Europe/Copenhagen",
              "Europe/Warsaw",
              "Europe/Prague",
              "Europe/Budapest",
              "Europe/Athens",
              "Europe/Helsinki",
              "Europe/Kyiv",
              "Europe/Bucharest",
              "Europe/Istanbul",
              "Europe/Moscow",
              "Africa/Algiers",
              "Africa/Tunis",
              "Africa/Lagos",
              "Africa/Dakar",
              "Africa/Abidjan",
              "Africa/Johannesburg",
              "Africa/Nairobi",
              "Asia/Dubai",
              "Asia/Karachi",
              "Asia/Kolkata",
              "Asia/Dhaka",
              "Asia/Bangkok",
              "Asia/Jakarta",
              "Asia/Ho_Chi_Minh",
              "Asia/Singapore",
              "Asia/Shanghai",
              "Asia/Hong_Kong",
              "Asia/Manila",
              "Asia/Seoul",
              "Asia/Tokyo",
              "Australia/Perth",
              "Australia/Brisbane",
              "Australia/Adelaide",
              "Australia/Sydney",
              "Australia/Melbourne",
              "Pacific/Auckland",
              "Pacific/Noumea",
              "Pacific/Tahiti",
              "Pacific/Honolulu",
              "America/Anchorage",
              "America/Los_Angeles",
              "America/Vancouver",
              "America/Phoenix",
              "America/Denver",
              "America/Chicago",
              "America/Mexico_City",
              "America/New_York",
              "America/Toronto",
              "America/Montreal",
              "America/Bogota",
              "America/Lima",
              "America/Halifax",
              "America/Martinique",
              "America/Guadeloupe",
              "America/St_Johns",
              "America/Sao_Paulo",
              "America/Argentina/Buenos_Aires",
              "Indian/Reunion"
            ],
            "default": "UTC"
          },
          "durationMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10080
          },
          "channel": {
            "type": "string",
            "x-cicord-ref": "channel"
          },
          "location": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "key",
          "name",
          "start",
          "durationMinutes"
        ],
        "additionalProperties": false
      },
      "default": []
    },
    "weeksAhead": {
      "type": "integer",
      "minimum": 1,
      "maximum": 26,
      "default": 4
    },
    "minMinutes": {
      "type": "integer",
      "minimum": 1,
      "default": 5
    },
    "announcementChannel": {
      "type": "string",
      "x-cicord-ref": "channel"
    },
    "role": {
      "type": "string",
      "x-cicord-ref": "role"
    }
  },
  "required": [],
  "additionalProperties": false
}
