{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "staffChannel": {
      "type": "string",
      "x-cicord-ref": "channel"
    },
    "counters": {
      "type": "array",
      "items": {
        "enum": [
          "members.total",
          "members.online",
          "members.boosting"
        ],
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "locale": {
      "type": "string",
      "enum": [
        "en",
        "fr"
      ],
      "description": "Report language. Falls back to the server locale when omitted."
    }
  },
  "required": [],
  "additionalProperties": false
}
