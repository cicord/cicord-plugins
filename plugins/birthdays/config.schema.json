{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Birthdays configuration",
  "type": "object",
  "properties": {
    "channel": {
      "type": "string",
      "description": "Birthday announcement channel.",
      "x-cicord-ref": "channel",
      "minLength": 1
    },
    "timeZone": {
      "type": "string",
      "description": "IANA time zone used when a member has no saved preference.",
      "enum": [
        "UTC",
        "Europe/London",
        "Europe/Dublin",
        "Europe/Lisbon",
        "Europe/Paris",
        "Europe/Brussels",
        "Europe/Amsterdam",
        "Europe/Luxembourg",
        "Europe/Berlin",
        "Europe/Zurich",
        "Europe/Vienna",
        "Europe/Madrid",
        "Europe/Rome",
        "Europe/Stockholm",
        "Europe/Oslo",
        "Europe/Copenhagen",
        "Europe/Warsaw",
        "Europe/Prague",
        "Europe/Budapest",
        "Europe/Athens",
        "Europe/Helsinki",
        "Europe/Kyiv",
        "Europe/Bucharest",
        "Europe/Istanbul",
        "Europe/Moscow",
        "Africa/Algiers",
        "Africa/Tunis",
        "Africa/Lagos",
        "Africa/Dakar",
        "Africa/Abidjan",
        "Africa/Johannesburg",
        "Africa/Nairobi",
        "Asia/Dubai",
        "Asia/Karachi",
        "Asia/Kolkata",
        "Asia/Dhaka",
        "Asia/Bangkok",
        "Asia/Jakarta",
        "Asia/Ho_Chi_Minh",
        "Asia/Singapore",
        "Asia/Shanghai",
        "Asia/Hong_Kong",
        "Asia/Manila",
        "Asia/Seoul",
        "Asia/Tokyo",
        "Australia/Perth",
        "Australia/Brisbane",
        "Australia/Adelaide",
        "Australia/Sydney",
        "Australia/Melbourne",
        "Pacific/Auckland",
        "Pacific/Noumea",
        "Pacific/Tahiti",
        "Pacific/Honolulu",
        "America/Anchorage",
        "America/Los_Angeles",
        "America/Vancouver",
        "America/Phoenix",
        "America/Denver",
        "America/Chicago",
        "America/Mexico_City",
        "America/New_York",
        "America/Toronto",
        "America/Montreal",
        "America/Bogota",
        "America/Lima",
        "America/Halifax",
        "America/Martinique",
        "America/Guadeloupe",
        "America/St_Johns",
        "America/Sao_Paulo",
        "America/Argentina/Buenos_Aires",
        "Indian/Reunion"
      ],
      "default": "UTC"
    },
    "hour": {
      "type": "integer",
      "description": "Local hour to celebrate.",
      "minimum": 0,
      "maximum": 23,
      "default": 9
    },
    "role": {
      "type": "string",
      "description": "Unmanaged membership birthday role.",
      "x-cicord-ref": "role",
      "minLength": 1
    },
    "eraseOnLeave": {
      "type": "boolean",
      "description": "Erase the birthday on leaving.",
      "default": true
    },
    "enabled": {
      "type": "boolean",
      "description": "Enable this plugin instance.",
      "default": true
    },
    "locale": {
      "type": "string",
      "description": "Override the language of this instance.",
      "enum": [
        "en",
        "fr"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "enabled": {
            "const": false
          }
        },
        "required": [
          "enabled"
        ]
      },
      "else": {
        "required": [
          "channel"
        ]
      }
    }
  ]
}
